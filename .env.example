# Ejemplo de variables de entorno para la aplicación
# Copia este archivo a `.env` y rellena los valores reales en tu entorno local/producción.

# Nombre del proyecto Docker Compose (mantiene el volumen proyectos_db_data existente en la VM)
COMPOSE_PROJECT_NAME=proyectos

# Base de datos MySQL (usado por `funciones/conexion.php` y `bd/conexion.php`)
DB_HOST=db
DB_PORT=3306
DB_NAME=info
DB_USER=root
DB_PASS=AdmSys2014

# URL base que usa algunas páginas para construir rutas (ver `funciones/conexion.php`).
# Opcional: si no se define, se calcula automáticamente según el host con el
# que el usuario accede (soporta acceso simultáneo por IP pública/privada/dominio).
# Solo defínela si necesitas forzar una URL fija (p. ej. detrás de un proxy que
# reescribe el Host).
# APP_SRC=http://172.10.18.128:9258

# Token del API (autenticación de `api/v1/index.php` → `api/Auth.php`).
# docker-compose.yml lo pasa como variable de entorno con un valor por defecto
# legacy; para mejor seguridad crea `.env` JUNTO al docker-compose.yml con:
#   API_SECRET_TOKEN=<genera_con: openssl rand -hex 32>
# y actualiza el token en Databricks (secrets scope informes_api).
API_SECRET_TOKEN=9035232260ca3fc11faa82b6b32b20605fe55c242e6903ca2f7e0887c3e9be17

# URL interna del microservicio Python (FastAPI) para operaciones matriciales y tareas programadas
PYTHON_API_URL=http://python_api:8000
