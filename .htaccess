# ========================================================
# INVERPALMAS - REGLAS DE SEGURIDAD Y CONFIGURACIÓN APACHE
# ========================================================

# 1. Deshabilitar listado de directorios
Options -Indexes

# 2. Proteger archivos críticos del sistema y de configuración
<FilesMatch "(^\.env|\.git|\.gitignore|\.htaccess|composer\.(json|lock)|Dockerfile|docker-compose\.yml|init\.sql|my\.cnf|php\.ini|.*\.sql)$">
    Require all denied
</FilesMatch>

# Bloquear cualquier archivo oculto (que empiece con punto)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 3. Cabeceras de seguridad HTTP
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 4. Límites de carga para importación de modelos Tika (6 archivos CSV ~70-150 MB)
php_value upload_max_filesize 256M
php_value post_max_size 256M
php_value memory_limit 512M
php_value max_execution_time 300
php_value max_input_time 300
