{
    "name": "inverpalmas/informes-agricolas",
    "description": "Aplicacion PHP para informes agricolas y modulos MVC graduales sobre src/.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "nesbot/carbon": "^1.39",
        "phpoffice/phpspreadsheet": "^1.8",
        "mpdf/mpdf": "^8.0",
        "twbs/bootstrap": "^5.3.3",
        "datatables/datatables": "^1.10",
        "components/jquery": "^3.7.1"
    },
    "require-dev": {
        "composer/composer": "^1.9"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "kylekatarnls/update-helper": false
        }
    }
}
